APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://farmsource:replace-postgres-password@db:5432/farmsource
POSTGRES_DB=farmsource
POSTGRES_USER=farmsource
POSTGRES_PASSWORD=replace-postgres-password
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
APP_BASE_URL=https://your-domain.example
SESSION_SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true
ADMIN_DEFAULT_EMAIL=admin@your-domain.example
ADMIN_DEFAULT_PASSWORD=replace-before-first-start
MARKETING_AI_PROVIDER=mock
RATE_LIMIT_ENABLED=false
WEB_CONCURRENCY=2
APP_PORT=127.0.0.1:8010
